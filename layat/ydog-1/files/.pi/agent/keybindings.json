{
  "$schema": "https://pi.dev/schemas/keybindings.schema.json",
  "tui.altScreen.halfPageUp": "ctrl+u",
  "tui.altScreen.halfPageDown": "ctrl+d",
  "tui.altScreen.lineUp": "ctrl+k",
  "tui.altScreen.lineDown": "ctrl+j",
  "tui.altScreen.previousPrompt": ["ctrl+shift+up", "ctrl+up", "alt+k"],
  "tui.altScreen.nextPrompt": ["ctrl+shift+down", "ctrl+down", "alt+j"],
  "tui.select.up": ["up", "ctrl+k"],
  "tui.select.down": ["down", "ctrl+j"],
  "tui.input.newLine": "shift+enter",
  "tui.editor.deleteToLineEnd": []
}
