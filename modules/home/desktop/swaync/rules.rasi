* {
    font: "@popup-font@";
    background-color: transparent;
    text-color: #e4e1e9;
}
window {
    location: center;
    width: 420px;
    border: 0;
    border-radius: @popup-radius@;
    background-color: #0b0a10;
}
mainbox { padding: 14px; spacing: 12px; children: [inputbar, listview, message]; }
inputbar {
    spacing: 10px;
    padding: 8px;
    border-radius: @popup-radius@;
    background-color: #313244;
    children: [prompt, entry];
}
prompt { text-color: #cba6f7; }
entry { placeholder: "Application…"; }
listview { lines: 8; fixed-height: false; spacing: 4px; }
element { padding: 10px; border-radius: @popup-radius@; }
element selected.normal { background-color: #4c3349; text-color: #ffd7f3; }
element-text { text-color: inherit; }
message { padding: 2px 8px; text-color: #313244; }